{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["dom", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "exclude": ["out-tsc", "dist", "**/*.spec.ts", "**/*.spec.tsx"],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    { "path": "../data-access-web/tsconfig.lib.json" },
    { "path": "../../ui-web/tsconfig.lib.json" }
  ]
}
